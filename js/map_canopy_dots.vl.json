{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Do birdwatchers follow the trees?",
    "anchor": "start",
    "fontSize": 22,
    "offset": {
      "expr": "width >= 575 ? 90 : 126"
    }
  },
  "width": "container",
  "height": 660,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "show",
      "value": 1
    },
    {
      "name": "mode",
      "value": 1
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/com_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9dfcd",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/com_canopy_grid_2021.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "tree_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "mode != 2"
        },
        {
          "calculate": "datum.lon + 0.0006",
          "as": "lon2"
        },
        {
          "calculate": "datum.lat + 0.0005",
          "as": "lat2"
        },
        {
          "calculate": "datum.tree_pct < 10 ? 'Under 10%' : datum.tree_pct < 25 ? '10 to 25%' : datum.tree_pct < 50 ? '25 to 50%' : '50% or more'",
          "as": "tree_band"
        },
        {
          "calculate": "datum.tree_pct + '% of this square (about 50 m across)'",
          "as": "tree_text"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": {
          "expr": "clamp(2 - show, 0, 1)"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        },
        "color": {
          "field": "tree_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Under 10%",
              "10 to 25%",
              "25 to 50%",
              "50% or more"
            ],
            "range": [
              "#dfe5c3",
              "#b5d59c",
              "#7fb96c",
              "#3f8f43"
            ]
          },
          "legend": {
            "title": "Ground covered by trees",
            "orient": "none",
            "legendX": 0,
            "legendY": -78,
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 160,
            "labelFontSize": 11,
            "titleLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "tree_text",
            "title": "Trees cover"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/com_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "black",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/com_inat_points_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "under_trees": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "mode != 0"
        },
        {
          "calculate": "datum.under_trees == 1 ? 'Yes' : 'No'",
          "as": "under_label"
        },
        {
          "calculate": "substring(datum.date, 8, 10) + '-' + substring(datum.date, 5, 7) + '-' + substring(datum.date, 0, 4)",
          "as": "date_dmy"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "strokeWidth": 0,
        "color": "#343065",
        "size": 14,
        "opacity": {
          "expr": "0.7 * clamp(show, 0, 1)"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "shape": {
          "datum": "One bird record",
          "scale": {
            "range": [
              "circle"
            ]
          },
          "legend": {
            "title": null,
            "orient": "none",
            "legendX": 390,
            "legendY": -62,
            "symbolFillColor": "#343065",
            "symbolStrokeWidth": 0,
            "symbolOpacity": 0.7,
            "symbolSize": 40,
            "labelFontSize": 11,
            "labelLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "bird",
            "title": "Bird"
          },
          {
            "field": "date_dmy",
            "title": "Date"
          },
          {
            "field": "under_label",
            "title": "Made under a tree"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/com_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#fbf3e6",
        "stroke": "#fbf3e6",
        "strokeWidth": 3,
        "opacity": 0.85,
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {
          "field": "properties.label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Parkville','Carlton','Melbourne','East Melbourne','Port Melbourne'], datum.properties.suburb) >= 0"
        },
        {
          "calculate": "datum.properties.suburb",
          "as": "label"
        }
      ]
    },
    {
      "data": {
        "url": "data/com_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "black",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {
          "field": "properties.label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Parkville','Carlton','Melbourne','East Melbourne','Port Melbourne'], datum.properties.suburb) >= 0"
        },
        {
          "calculate": "datum.properties.suburb",
          "as": "label"
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "font": "Fraunces",
      "fontWeight": 600,
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal"
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "domainColor": "#8c7458",
      "tickColor": "#8c7458",
      "gridColor": "#e8d9c3"
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "header": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "text": {
      "color": "black"
    },
    "font": "Inter"
  }
}
