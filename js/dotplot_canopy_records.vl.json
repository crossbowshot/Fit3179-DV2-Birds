{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Not all trees get the same attention",
    "anchor": "start",
    "fontSize": 22
  },
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/com_suburb_canopy_records_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "records": "number",
        "tree_cover_pct": "number",
        "share_of_trees_pct": "number",
        "share_of_records_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.suburb == 'Melbourne' ? 'Melbourne (Botanic Gardens)' : datum.suburb == 'Parkville' ? 'Parkville (Royal Park)' : datum.suburb == 'East Melbourne' ? 'East Melbourne (Fitzroy Gardens)' : datum.suburb",
      "as": "place"
    },
    {
      "fold": [
        "share_of_trees_pct",
        "share_of_records_pct"
      ],
      "as": [
        "measure",
        "share"
      ]
    },
    {
      "calculate": "datum.measure == 'share_of_trees_pct' ? \"Share of the City's trees\" : 'Share of the bird records'",
      "as": "what"
    }
  ],
  "encoding": {
    "y": {
      "field": "place",
      "type": "nominal",
      "sort": {
        "field": "share_of_trees_pct",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelFontSize": 11,
        "labelLimit": 300,
        "labelPadding": 8,
        "labelExpr": "indexof(datum.label, ' (') > 0 ? [substring(datum.label, 0, indexof(datum.label, ' (')), substring(datum.label, indexof(datum.label, ' (') + 1)] : datum.label",
        "labelLineHeight": 12,
        "labelOffset": {
          "condition": {
            "test": "indexof(datum.label, ' (') > 0",
            "value": -6
          },
          "value": 0
        }
      }
    },
    "x": {
      "field": "share",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          35
        ]
      },
      "axis": {
        "title": null,
        "labelExpr": "datum.value + '%'",
        "tickCount": 4,
        "grid": true,
        "gridColor": "#e8d9c3",
        "domain": false,
        "labelFontSize": 14,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#8c7458",
        "strokeWidth": 2.5
      },
      "encoding": {
        "detail": {
          "field": "place"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "what",
          "type": "nominal",
          "scale": {
            "domain": [
              "Share of the City's trees",
              "Share of the bird records"
            ],
            "range": [
              "#21823f",
              "#343065"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom-right",
            "symbolType": "circle",
            "labelFontSize": 11,
            "labelLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "place",
            "title": "title"
          },
          {
            "field": "trees_text",
            "title": "Share of the City's trees"
          },
          {
            "field": "records_text",
            "title": "Share of the bird records"
          },
          {
            "field": "records",
            "title": "Bird records",
            "format": ","
          }
        ]
      },
      "transform": [
        {
          "calculate": "format(+datum.share_of_trees_pct, '.1f') + '%'",
          "as": "trees_text"
        },
        {
          "calculate": "format(+datum.share_of_records_pct, '.1f') + '%'",
          "as": "records_text"
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "font": "Fraunces",
      "fontWeight": 600,
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal"
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "domainColor": "#8c7458",
      "tickColor": "#8c7458",
      "gridColor": "#e8d9c3"
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "header": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "text": {
      "color": "black"
    },
    "font": "Inter"
  },
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 0
  }
}
