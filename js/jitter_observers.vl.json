{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "A few keen people make most of the records",
    "anchor": "start",
    "fontSize": 22,
    "offset": 30
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/inat_observer_records_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "records": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.records >= 4246 ? 0.5 : random()",
      "as": "jitter"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 18,
        "opacity": 0.65
      },
      "encoding": {
        "color": {
          "datum": "One dot = one person",
          "scale": {
            "range": [
              "#343065"
            ]
          },
          "legend": {
            "title": null,
            "orient": "none",
            "symbolType": "circle",
            "symbolSize": 60,
            "symbolOpacity": 0.65,
            "labelFontSize": 12,
            "legendX": 0,
            "legendY": -48
          }
        },
        "tooltip": [
          {
            "field": "heading",
            "title": "title"
          },
          {
            "field": "records",
            "title": "Bird records in 2024",
            "format": ","
          }
        ]
      },
      "transform": [
        {
          "calculate": "'One iNaturalist user'",
          "as": "heading"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "records": 4246,
            "jitter": 0.53,
            "jitter2": 1.08
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b5a48",
        "strokeWidth": 0.8
      },
      "encoding": {
        "y2": {
          "field": "jitter2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "px": 0,
            "py": -3,
            "step": 1
          },
          {
            "px": 0,
            "py": -22,
            "step": 2
          },
          {
            "px": 165,
            "py": -22,
            "step": 3
          },
          {
            "px": 165,
            "py": -35,
            "step": 4
          }
        ]
      },
      "mark": {
        "type": "line",
        "color": "#6b5a48",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "py",
          "type": "quantitative",
          "scale": null
        },
        "order": {
          "field": "step"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "px": 158,
            "py": -43,
            "text": "972 people made just one record"
          }
        ]
      },
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11,
        "color": "black",
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "py",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "records": 4246,
            "jitter": 1.156,
            "text": "One person: 4,246 records,\nabout 1 in 10 iNaturalist records"
          }
        ]
      },
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11,
        "color": "black",
        "lineBreak": "\n",
        "align": "right",
        "dx": 4
      },
      "encoding": {
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "font": "Fraunces",
      "fontWeight": 600,
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal"
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "domainColor": "#8c7458",
      "tickColor": "#8c7458",
      "gridColor": "#e8d9c3"
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "header": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "text": {
      "color": "black"
    },
    "font": "Inter"
  },
  "encoding": {
    "x": {
      "field": "records",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          1,
          5000
        ]
      },
      "axis": {
        "title": "Bird records",
        "titleFontSize": 14,
        "titlePadding": 8,
        "values": [
          1,
          10,
          100,
          1000
        ],
        "format": ",d",
        "grid": true,
        "gridColor": "#e8d9c3",
        "domain": false,
        "ticks": false,
        "labelFontSize": 14,
        "titleLimit": 600,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "jitter",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -0.01,
          1.01
        ]
      }
    }
  },
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 0
  }
}
