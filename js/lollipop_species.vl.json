{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Melbourne's 15 most reported birds",
    "anchor": "start",
    "fontSize": 22
  },
  "width": "container",
  "height": 400,
  "padding": {
    "left": 5,
    "top": 5,
    "right": 45,
    "bottom": 0
  },
  "data": {
    "url": "data/melb_top15_species_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "records": "number",
        "birds_counted": "number",
        "share_pct": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "sort": {
        "field": "records",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelPadding": 114,
        "labelLimit": 300,
        "labelExpr": "datum.label == 'Sulphur-crested Cockatoo' ? ['Sulphur-crested', 'Cockatoo'] : datum.label",
        "labelLineHeight": 13,
        "labelOffset": {
          "condition": {
            "test": "datum.label == 'Sulphur-crested Cockatoo'",
            "value": -6.5
          },
          "value": 0
        },
        "labelAlign": "left"
      }
    },
    "x": {
      "field": "records",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          44000
        ]
      },
      "axis": {
        "title": null,
        "format": ",d",
        "tickCount": 5,
        "grid": false,
        "labelFontSize": 14,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Native",
              "Introduced"
            ],
            "range": [
              "#5e5887",
              "#b4b0cf"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1,
        "stroke": "#343065",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Native",
              "Introduced"
            ],
            "range": [
              "#5e5887",
              "#ffffff"
            ]
          },
          "legend": {
            "title": "Legend",
            "orient": "none",
            "symbolType": "circle",
            "labelFontSize": 12,
            "direction": "vertical",
            "symbolStrokeColor": "#343065",
            "symbolStrokeWidth": 1.5,
            "titleOrient": "top",
            "titleFontSize": 12,
            "titlePadding": 6,
            "legendX": {
              "expr": "width - 95"
            },
            "legendY": {
              "expr": "height - 75"
            }
          }
        },
        "tooltip": [
          {
            "field": "species",
            "title": "title"
          },
          {
            "field": "share_text",
            "title": "Share of all records"
          }
        ]
      },
      "transform": [
        {
          "calculate": "format(datum.share_pct / 100, '.1%') + ' (about 1 in ' + round(100 / datum.share_pct) + ')'",
          "as": "share_text"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 11,
        "color": "black"
      },
      "encoding": {
        "text": {
          "field": "records",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "font": "Fraunces",
      "fontWeight": 600,
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal"
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "domainColor": "#8c7458",
      "tickColor": "#8c7458",
      "gridColor": "#e8d9c3"
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "header": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "text": {
      "color": "black"
    },
    "font": "Inter"
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
