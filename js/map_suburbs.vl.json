{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Which suburb in Melbourne reports the most birds for its population?",
    "anchor": "start",
    "fontSize": 25,
    "subtitle": "Bird records per 1,000 residents",
    "subtitleFontSize": 18
  },
  "width": "container",
  "height": 1000,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "minPop",
      "value": 1000
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/melb_suburbs.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.sal_code",
          "from": {
            "data": {
              "url": "data/melb_suburb_bird_records_2024.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "bird_records": "number",
                  "population_2021": "number",
                  "records_per_1000_residents": "number"
                }
              }
            },
            "key": "sal_code",
            "fields": [
              "suburb",
              "bird_records",
              "population_2021",
              "records_per_1000_residents"
            ]
          }
        },
        {
          "calculate": "datum.population_2021 < minPop ? 'Fewer than 1,000 residents' : datum.records_per_1000_residents < 25 ? 'Under 25' : datum.records_per_1000_residents < 100 ? '25 to 100' : datum.records_per_1000_residents < 250 ? '100 to 250' : datum.records_per_1000_residents < 500 ? '250 to 500' : datum.records_per_1000_residents < 1000 ? '500 to 1,000' : '1,000 or more'",
          "as": "rate_band"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "black",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "rate_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Fewer than 1,000 residents",
              "Under 25",
              "25 to 100",
              "100 to 250",
              "250 to 500",
              "500 to 1,000",
              "1,000 or more"
            ],
            "range": [
              "#ddd0bb",
              "#e2e0f5",
              "#b4b0cf",
              "#8883ab",
              "#5e5887",
              "#343065",
              "#000c44"
            ]
          },
          "legend": {
            "title": "Records per 1,000 residents",
            "titleLimit": 300,
            "orient": "bottom-left",
            "symbolType": "square",
            "symbolSize": 160,
            "labelFontSize": 11,
            "labelLimit": 260
          }
        },
        "tooltip": [
          {
            "field": "suburb",
            "title": "title"
          },
          {
            "field": "records_per_1000_residents",
            "title": "Records per 1,000 residents",
            "format": ",.0f"
          },
          {
            "field": "bird_records",
            "title": "Bird records",
            "format": ","
          },
          {
            "field": "population_2021",
            "title": "Residents",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 145.152,
            "lat": -38.381,
            "lon2": 145.33,
            "lat2": -38.47
          },
          {
            "lon": 144.66,
            "lat": -37.836,
            "lon2": 144.47,
            "lat2": -38.2
          },
          {
            "lon": 144.618,
            "lat": -37.962,
            "lon2": 144.77,
            "lat2": -38.08
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "black",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.77,
            "lat": -38.08,
            "text": "Western Treatment Plant\n(Cocoroc): 57,416\nrecords, no residents"
          },
          {
            "lon": 145.33,
            "lat": -38.47,
            "text": "Somers: highest rate,\n4,113 records per\n1,000 residents"
          },
          {
            "lon": 144.47,
            "lat": -38.2,
            "text": "Tarneit: 56,370 residents\nbut only 388 bird records"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineBreak": "\n",
        "baseline": "middle",
        "dx": 3,
        "color": "black",
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "background": "#fbf3e6",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "font": "Fraunces",
      "fontWeight": 600,
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal"
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "domainColor": "#8c7458",
      "tickColor": "#8c7458",
      "gridColor": "#e8d9c3"
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "header": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "text": {
      "color": "black"
    },
    "font": "Inter"
  }
}
