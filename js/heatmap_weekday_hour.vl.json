{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Birds don't keep office hours, but birdwatchers do",
    "anchor": "start",
    "fontSize": 22
  },
  "width": "container",
  "height": 210,
  "data": {
    "url": "data/inat_weekday_hour_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "weekday_num": "number",
        "hour": "number",
        "records": "number"
      }
    }
  },
  "mark": {
    "type": "rect",
    "stroke": "#fbf3e6",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "hour",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "values": [
          0,
          3,
          6,
          9,
          12,
          15,
          18,
          21
        ],
        "labelExpr": "datum.value == 0 ? '12am' : datum.value < 12 ? datum.value + 'am' : datum.value == 12 ? '12pm' : (datum.value - 12) + 'pm'",
        "ticks": false,
        "domain": false,
        "labelFontSize": 14,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "weekday",
      "type": "ordinal",
      "sort": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
      ],
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontSize": 12
      }
    },
    "color": {
      "field": "records",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1000
        ],
        "range": [
          "#e2e0f5",
          "#000c44"
        ]
      },
      "legend": {
        "title": "Records",
        "orient": "right",
        "format": ",d",
        "values": [
          0,
          1000
        ],
        "gradientLength": 160
      }
    },
    "tooltip": [
      {
        "field": "heading",
        "title": "title"
      },
      {
        "field": "records",
        "title": "Bird records",
        "format": ","
      }
    ]
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "font": "Fraunces",
      "fontWeight": 600,
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal"
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "domainColor": "#8c7458",
      "tickColor": "#8c7458",
      "gridColor": "#e8d9c3"
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "header": {
      "labelColor": "black",
      "titleColor": "black"
    },
    "text": {
      "color": "black"
    },
    "font": "Inter"
  },
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 0
  },
  "transform": [
    {
      "calculate": "{'Mon':'Monday','Tue':'Tuesday','Wed':'Wednesday','Thu':'Thursday','Fri':'Friday','Sat':'Saturday','Sun':'Sunday'}[datum.weekday]",
      "as": "day_name"
    },
    {
      "calculate": "(datum.hour % 12 == 0 ? 12 : datum.hour % 12) + (datum.hour < 12 ? 'am' : 'pm')",
      "as": "from_text"
    },
    {
      "calculate": "((datum.hour + 1) % 12 == 0 ? 12 : (datum.hour + 1) % 12) + ((datum.hour + 1) % 24 < 12 ? 'am' : 'pm')",
      "as": "to_text"
    },
    {
      "calculate": "datum.day_name + ', ' + datum.from_text + ' to ' + datum.to_text",
      "as": "heading"
    }
  ]
}
